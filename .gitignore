# Rust
/target/
**/*.rs.bk

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.hypothesis/

# Editors and OS
.DS_Store
*.swp
.idea/
.vscode/

# Tooling
/mutants.out*/
.mypy_cache/
.ruff_cache/
.hypothesis/

# The editable install writes the extension next to the package.
python/cachette/*.so
python/cachette/*.pyd
python/cachette/*.dylib

# Agent worktrees and scratch state. They are not project files.
.claude/worktrees/
.claude/tackline/
.agents/worktrees/
.agents/last-docs-run
.claude/last-docs-run

# The observability stack copies a benchmark run log here so that the
# collector can read it. The run itself is the record, not the copy.
observability/runs/*.log

# The output of a training run in flight. A checkout that replaced the
# log would leave the shell redirect writing to a deleted inode, and the
# rest of the run would go nowhere. The finished artefacts are committed
# once the run ends.
runs/learn/night2/

# A running job writes here. A checkout must not manage a path a job writes,
# and a run directory holds its own private key while its instance lives.
runs/
